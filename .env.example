# SQLite file (default: campus.db in the repo root)
DB_PATH=campus.db
# Minutes with nobody in the room before a booking is released as a ghost booking
GHOST_RELEASE_MIN=10
# Override for a short demo
# GHOST_GRACE_SECONDS=5
# GHOST_RELEASE_SECONDS=15
# If set, POST /api/readings needs the header X-Token with this value
READINGS_TOKEN=change-me
# Camera frame key, 32 hex characters (default: read from firmware/xiao_sense/frame_key.h)
# FRAME_KEY=00112233445566778899aabbccddeeff
# Simulated rooms (every room except the board room): 0 turns off noise/people simulation, CAMPUS_SIM=0 only the
# simulated "Other students" bookings
# SIMULATE=1
# CAMPUS_SIM=1
# Room display window (app/display.py): opens when the board runs; 0 turns it off. Browser: Edge or Chrome, found
# by itself, or give the path. DISPLAY_TOKEN fixes the display's token (default: new on every start, printed in the log)
# DISPLAY_WINDOW=1
# DISPLAY_BROWSER=C:\Program Files\Google\Chrome\Application\chrome.exe
# DISPLAY_TOKEN=dev-display
# Address used in QR codes (default: the running tunnel from tools/tunnel.py, else the address the request came in on)
# PUBLIC_URL=https://example.trycloudflare.com
