# SQLite file (default: campus.db in the repo root)
DB_PATH=campus.db
# Minutes with nobody in the room before a booking is released as a ghost booking
GHOST_RELEASE_MIN=15
# If set, POST /api/readings needs the header X-Token with this value
READINGS_TOKEN=change-me
# Set to 0 to skip the live ntfy noise feed for V.1.07a (tests, offline work)
NOISE_FEED=1
