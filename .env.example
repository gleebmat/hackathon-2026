# SQLite file (default: campus.db in the repo root)
DB_PATH=campus.db
# Minutes with nobody in the room before a booking is released as a ghost booking
GHOST_RELEASE_MIN=10
# Override for a short demo
# GHOST_GRACE_SECONDS=5
# GHOST_RELEASE_SECONDS=15
# If set, POST /api/readings needs the header X-Token with this value
READINGS_TOKEN=change-me
# Camera frame key, 32 hex characters (default: read from firmware/xiao_sense/frame_key.h)
# FRAME_KEY=00112233445566778899aabbccddeeff
